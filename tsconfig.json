{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "declaration": true,
    "lib": [
      "ES2020"
    ],
    "types": []
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__"
  ]
}
